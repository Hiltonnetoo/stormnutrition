rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // User profile pictures:
    // 1. Readable by authenticated users.
    // 2. Upload restricted to the owner of the path (userId == request.auth.uid).
    // 3. Technical limits: max 5MB size, valid image content type.
    match /profilePictures/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    // Default deny for all other storage paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
