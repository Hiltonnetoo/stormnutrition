# Configuração sintética e PÚBLICA para os emuladores Firebase — não é segredo.
#
# Usada no lugar do .env.local pessoal por:
#   - `vite --mode emulator` (npm run dev:emulated, npm run dev:emulator e E2E);
#   - as suítes Vitest (unitária, regras e benchmark de consultas).
# Assim testes e demo local nunca leem credenciais reais nem chaves de e-mail.
#
# O projeto precisa começar com "demo-": o Firebase CLI trata esses projetos
# como fictícios, e serviços sem emulador (ex.: Storage) não alcançam a nuvem.
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_API_KEY=demo-api-key-not-a-secret
VITE_FIREBASE_AUTH_DOMAIN=demo-storm.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-storm
VITE_FIREBASE_STORAGE_BUCKET=demo-storm.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demostorm000000
VITE_FIREBASE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080

# Transporte de e-mail 100% simulado (bloqueia qualquer envio externo via EmailJS)
VITE_EMAIL_TRANSPORT=simulated
