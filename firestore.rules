rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------- Helpers
    function isAuthenticated() {
      return request.auth != null;
    }

    // The nutritionist owns the workspace under /users/{userId}.
    // Verifies authentication and ensures the user is a registered nutritionist,
    // preventing arbitrary accounts or patients from operating as nutritionists.
    // Unprofiled accounts do not silently receive nutritionist privileges.
    function isNutritionist(userId) {
      return isAuthenticated() &&
        request.auth.uid == userId &&
        exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.role == 'nutritionist';
    }

    function getPatientProfile() {
      return get(/databases/$(database)/documents/patientProfiles/$(request.auth.uid)).data;
    }

    function hasPatientProfile() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/patientProfiles/$(request.auth.uid)) &&
        (!('status' in getPatientProfile()) || getPatientProfile().status != 'revoked');
    }

    // True when the signed-in patient is the one linked to
    // users/{userId}/patients/{patientId}.
    function isAssociatedPatient(userId, patientId) {
      return hasPatientProfile() &&
        getPatientProfile().nutritionistId == userId &&
        getPatientProfile().patientId == patientId;
    }

    // True when the signed-in patient owns a document (diet/appointment) under
    // users/{userId}, matched by the document's patientId field.
    // Also cross-verifies that the patient record in the nutritionist's workspace
    // actually has portalUid == request.auth.uid and portalStatus != 'revoked'.
    function isOwnerPatientByField(userId) {
      return hasPatientProfile() &&
        getPatientProfile().nutritionistId == userId &&
        resource.data.patientId == getPatientProfile().patientId &&
        exists(/databases/$(database)/documents/users/$(userId)/patients/$(getPatientProfile().patientId)) &&
        get(/databases/$(database)/documents/users/$(userId)/patients/$(getPatientProfile().patientId)).data.portalUid == request.auth.uid &&
        (!('portalStatus' in get(/databases/$(database)/documents/users/$(userId)/patients/$(getPatientProfile().patientId)).data) ||
         get(/databases/$(database)/documents/users/$(userId)/patients/$(getPatientProfile().patientId)).data.portalStatus != 'revoked') &&
        (!('status' in get(/databases/$(database)/documents/users/$(userId)/patients/$(getPatientProfile().patientId)).data) ||
         get(/databases/$(database)/documents/users/$(userId)/patients/$(getPatientProfile().patientId)).data.status != 'Archived') &&
        (!('deletionPending' in get(/databases/$(database)/documents/users/$(userId)/patients/$(getPatientProfile().patientId)).data) ||
         get(/databases/$(database)/documents/users/$(userId)/patients/$(getPatientProfile().patientId)).data.deletionPending != true);
    }

    // Patient validity for related writes (diets, appointments, invitations, direct profile provisioning)
    // Ensures patient exists under the nutritionist's workspace, is not archived, and is not in deletion pending.
    function isPatientActiveAndWritable(userId, patientId) {
      return patientId is string &&
        exists(/databases/$(database)/documents/users/$(userId)/patients/$(patientId)) &&
        (!('deletionPending' in get(/databases/$(database)/documents/users/$(userId)/patients/$(patientId)).data) ||
          get(/databases/$(database)/documents/users/$(userId)/patients/$(patientId)).data.deletionPending != true) &&
        (!('status' in get(/databases/$(database)/documents/users/$(userId)/patients/$(patientId)).data) ||
          get(/databases/$(database)/documents/users/$(userId)/patients/$(patientId)).data.status != 'Archived');
    }

    // Patient self-service update validation:
    // 1. Only self-service fields can be modified.
    // 2. Existing historical entries (weightHistory, adherenceLog) cannot be replaced, altered or truncated.
    // 3. New weight entries must have valid self-reported/remote-guided origin and match auth UID.
    // 4. Protocols in selfEvaluations cannot be fabricated or altered when no active protocol is requested.
    // R02 — dates written by the patient: "YYYY-MM-DD" or an ISO timestamp
    // starting with it; never more than one day ahead of the server clock
    // (timezone slack). Legacy entries are not re-validated.
    function isCivilDateString(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}.*');
    }
    function isNotFutureDate(value) {
      let parts = value.split('T')[0].split('-');
      return timestamp.date(int(parts[0]), int(parts[1]), int(parts[2])) <=
        request.time + duration.value(1, 'd');
    }
    function isPatientDateValid(value) {
      return isCivilDateString(value) && isNotFutureDate(value);
    }

    function isCurrentWeightValid() {
      let diff = request.resource.data.diff(resource.data);
      let isAffected = 'weight' in diff.affectedKeys();
      let weightOk = request.resource.data.weight is number &&
        request.resource.data.weight >= 10 &&
        request.resource.data.weight <= 500;
      return !isAffected || weightOk;
    }

    function isWeightHistoryValid() {
      let diff = request.resource.data.diff(resource.data);
      let isAffected = 'weightHistory' in diff.affectedKeys();

      let oldHistory = ('weightHistory' in resource.data) ? resource.data.weightHistory : [];
      let newHistory = request.resource.data.weightHistory;

      let sizeOk = newHistory.size() == oldHistory.size() + 1;
      let lastRec = sizeOk ? newHistory[newHistory.size() - 1] : null;
      let appendOk = sizeOk && (newHistory == oldHistory.concat([lastRec]));

      let lastRecOk = sizeOk &&
        lastRec.keys().hasOnly(['id', 'date', 'weight', 'origin', 'authorUid', 'clientEventId']) &&
        lastRec.origin in ['self_reported', 'remote_guided'] &&
        'authorUid' in lastRec && lastRec.authorUid == request.auth.uid &&
        lastRec.weight is number &&
        lastRec.weight >= 10 &&
        lastRec.weight <= 500 &&
        isPatientDateValid(lastRec.date);

      return !isAffected || (appendOk && lastRecOk);
    }

    // R02 — response fields a patient may fill when completing a protocol.
    // Measurements: numbers 0–500 (0 = not informed); wellbeing scores 1–5.
    function isMeasurementValid(m, key) {
      return !(key in m) || (m[key] is number && m[key] >= 0 && m[key] <= 500);
    }
    function isScoreValid(w, key) {
      return !(key in w) || (w[key] is int && w[key] >= 1 && w[key] <= 5);
    }
    function isEvaluationResponseValid(ev) {
      let m = ev.get('measurements', {});
      let w = ev.get('wellbeing', {});
      return m is map && w is map &&
        m.keys().hasOnly(['weight', 'waist', 'hip', 'neck']) &&
        isMeasurementValid(m, 'weight') && isMeasurementValid(m, 'waist') &&
        isMeasurementValid(m, 'hip') && isMeasurementValid(m, 'neck') &&
        w.keys().hasOnly(['sleepQuality', 'energyLevel', 'satiety', 'digestiveHealth']) &&
        isScoreValid(w, 'sleepQuality') && isScoreValid(w, 'energyLevel') &&
        isScoreValid(w, 'satiety') &&
        (!('digestiveHealth' in w) || (w.digestiveHealth is string && w.digestiveHealth.size() <= 200)) &&
        (!('notes' in ev) || (ev.notes is string && ev.notes.size() <= 2000));
    }

    function isEvaluationsValid() {
      let diff = request.resource.data.diff(resource.data);
      let evAffected = 'selfEvaluations' in diff.affectedKeys();
      let protoAffected = 'activeProtocolId' in diff.affectedKeys();

      // R02: the patient clears the active protocol only by answering it
      // (a pending protocol cannot be dismissed without a response).
      let protoOk = !protoAffected || (
        evAffected &&
        request.resource.data.activeProtocolId == null &&
        ('activeProtocolId' in resource.data && resource.data.activeProtocolId != null)
      );

      let oldEv = ('selfEvaluations' in resource.data) ? resource.data.selfEvaluations : [];
      let newEv = request.resource.data.selfEvaluations;

      let oldTarget = evAffected && oldEv.removeAll(newEv).size() == 1 ? oldEv.removeAll(newEv)[0] : null;
      let newTarget = evAffected && newEv.removeAll(oldEv).size() == 1 ? newEv.removeAll(oldEv)[0] : null;

      let targetFieldsOk = oldTarget != null && newTarget != null && (
        newTarget.keys().hasOnly(['id', 'requestDate', 'status', 'completionDate', 'measurements', 'wellbeing', 'notes']) &&
        newTarget.id == oldTarget.id &&
        newTarget.requestDate == oldTarget.requestDate &&
        newTarget.status == "completed" &&
        oldTarget.status == "pending" &&
        isPatientDateValid(newTarget.completionDate) &&
        isEvaluationResponseValid(newTarget)
      );

      let evOk = !evAffected || (
        ('activeProtocolId' in resource.data && resource.data.activeProtocolId != null) &&
        request.resource.data.activeProtocolId == null &&
        newEv.size() == oldEv.size() &&
        targetFieldsOk &&
        oldTarget.id == resource.data.activeProtocolId
      );

      return protoOk && evOk;
    }

    function isAdherenceValid() {
      let diff = request.resource.data.diff(resource.data);
      let isAffected = 'adherenceLog' in diff.affectedKeys();

      let oldLog = ('adherenceLog' in resource.data) ? resource.data.adherenceLog : [];
      let newLog = request.resource.data.adherenceLog;

      let appendedElements = newLog.removeAll(oldLog);
      let removedElements = oldLog.removeAll(newLog);

      let isAppend = removedElements.size() == 0 && appendedElements.size() == 1 && newLog == oldLog.concat(appendedElements);

      let isUpdate = removedElements.size() == 1 && appendedElements.size() == 1 &&
        newLog.size() == oldLog.size() &&
        removedElements[0].date == appendedElements[0].date;

      // R02: the written entry has only check-in fields, a boolean answer
      // and a civil date that is not in the future.
      let entryOk = appendedElements.size() == 1 &&
        appendedElements[0].keys().hasOnly(['date', 'followed', 'timestamp', 'clientEventId']) &&
        appendedElements[0].followed is bool &&
        isPatientDateValid(appendedElements[0].date);

      return !isAffected || ((isAppend || isUpdate) && entryOk);
    }

    function patientWriteIsSelfServiceValid() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'weight',
          'weightHistory',
          'selfEvaluations',
          'adherenceLog',
          'activeProtocolId'
        ]) &&
        isCurrentWeightValid() &&
        isWeightHistoryValid() &&
        isEvaluationsValid() &&
        isAdherenceValid();
    }

    // ------------------------------------------------------ invitations
    match /invitations/{inviteId} {
      // Individual invite details can be fetched by someone accessing the invitation link
      allow get: if true;

      // Nutritionist can list only invitations they issued
      allow list: if isAuthenticated() && resource.data.nutritionistId == request.auth.uid;

      // Nutritionist creates pending invitation for an existing active patient
      allow create: if isAuthenticated() &&
        request.resource.data.nutritionistId == request.auth.uid &&
        isNutritionist(request.auth.uid) &&
        request.resource.data.status == "pending" &&
        request.resource.data.patientId is string &&
        request.resource.data.patientEmail is string &&
        request.resource.data.expiresAt is string &&
        'expiresAtTimestamp' in request.resource.data &&
        request.resource.data.expiresAtTimestamp is timestamp &&
        request.resource.data.expiresAtTimestamp > request.time &&
        isPatientActiveAndWritable(request.auth.uid, request.resource.data.patientId);

      // Nutritionist can revoke, OR patient can accept in an atomic batch
      allow update: if isAuthenticated() && (
        // Revoke by nutritionist:
        (resource.data.nutritionistId == request.auth.uid &&
         isNutritionist(request.auth.uid) &&
         request.resource.data.status == "revoked" &&
         resource.data.status == "pending")
        ||
        // Accept by authenticated patient (must be coordinated with patientProfile and patient doc):
        (resource.data.status == "pending" &&
         request.resource.data.status == "accepted" &&
         request.resource.data.acceptedByUid == request.auth.uid &&
         request.resource.data.nutritionistId == resource.data.nutritionistId &&
         request.resource.data.patientId == resource.data.patientId &&
         request.resource.data.patientEmail == resource.data.patientEmail &&
         request.time < resource.data.expiresAtTimestamp &&
         'email' in request.auth.token &&
         request.auth.token.email.lower() == resource.data.patientEmail.lower() &&
         exists(/databases/$(database)/documents/users/$(resource.data.nutritionistId)/patients/$(resource.data.patientId)) &&
         ((!('status' in get(/databases/$(database)/documents/users/$(resource.data.nutritionistId)/patients/$(resource.data.patientId)).data) ||
           get(/databases/$(database)/documents/users/$(resource.data.nutritionistId)/patients/$(resource.data.patientId)).data.status != 'Archived')) &&
         ((!('deletionPending' in get(/databases/$(database)/documents/users/$(resource.data.nutritionistId)/patients/$(resource.data.patientId)).data) ||
           get(/databases/$(database)/documents/users/$(resource.data.nutritionistId)/patients/$(resource.data.patientId)).data.deletionPending != true)) &&
         'pendingInvitationId' in get(/databases/$(database)/documents/users/$(resource.data.nutritionistId)/patients/$(resource.data.patientId)).data &&
         get(/databases/$(database)/documents/users/$(resource.data.nutritionistId)/patients/$(resource.data.patientId)).data.pendingInvitationId == inviteId &&
         existsAfter(/databases/$(database)/documents/patientProfiles/$(request.auth.uid)) &&
         getAfter(/databases/$(database)/documents/patientProfiles/$(request.auth.uid)).data.patientId == resource.data.patientId &&
         getAfter(/databases/$(database)/documents/patientProfiles/$(request.auth.uid)).data.nutritionistId == resource.data.nutritionistId &&
         getAfter(/databases/$(database)/documents/users/$(resource.data.nutritionistId)/patients/$(resource.data.patientId)).data.portalUid == request.auth.uid)
      );

      // Nutritionist can delete invitations associated with their patients
      allow delete: if isAuthenticated() &&
        resource.data.nutritionistId == request.auth.uid &&
        isNutritionist(request.auth.uid);
    }

    // ------------------------------------------------------ patientProfiles
    match /patientProfiles/{profileId} {
      // The profile owner (patient) and the linked nutritionist can read it.
      allow read: if isAuthenticated() &&
        (request.auth.uid == profileId || resource.data.nutritionistId == request.auth.uid);

      // Link profile can be created ONLY in two secure scenarios:
      // 1. By the nutritionist who owns the patient workspace (direct portal provisioning)
      // 2. By the authenticated patient accepting an active, matching, unexpired invitation in an atomic batch
      allow create: if isAuthenticated() &&
        request.resource.data.role == "patient" &&
        request.resource.data.patientId is string &&
        request.resource.data.nutritionistId is string &&
        (
          // Scenario 1: Nutritionist direct creation
          (
            request.resource.data.nutritionistId == request.auth.uid &&
            isNutritionist(request.auth.uid) &&
            isPatientActiveAndWritable(request.auth.uid, request.resource.data.patientId)
          )
          ||
          // Scenario 2: Patient accepting invitation via atomic batch
          (
            request.auth.uid == profileId &&
            'invitationId' in request.resource.data &&
            request.resource.data.invitationId is string &&
            exists(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)) &&
            get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.status == "pending" &&
            get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.nutritionistId == request.resource.data.nutritionistId &&
            get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.patientId == request.resource.data.patientId &&
            request.time < get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.expiresAtTimestamp &&
            'email' in request.auth.token &&
            request.auth.token.email.lower() == get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.patientEmail.lower() &&
            getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.status == "accepted" &&
            getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.acceptedByUid == request.auth.uid &&
            getAfter(/databases/$(database)/documents/users/$(request.resource.data.nutritionistId)/patients/$(request.resource.data.patientId)).data.portalUid == request.auth.uid
          )
        );

      // Only the linked nutritionist can update/delete it, with immutable association IDs.
      // (Exception: Patient can update their own profile during existing-account invitation re-link via atomic batch)
      allow update: if isAuthenticated() && (
        (
          resource.data.nutritionistId == request.auth.uid &&
          isNutritionist(request.auth.uid) &&
          request.resource.data.patientId == resource.data.patientId &&
          request.resource.data.nutritionistId == resource.data.nutritionistId &&
          request.resource.data.role == resource.data.role
        )
        ||
        (
          request.auth.uid == profileId &&
          request.resource.data.role == "patient" &&
          'invitationId' in request.resource.data &&
          request.resource.data.invitationId is string &&
          exists(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)) &&
          get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.status == "pending" &&
          get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.nutritionistId == request.resource.data.nutritionistId &&
          get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.patientId == request.resource.data.patientId &&
          request.time < get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.expiresAtTimestamp &&
          'email' in request.auth.token &&
          request.auth.token.email.lower() == get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.patientEmail.lower() &&
          getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.status == "accepted" &&
          getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.acceptedByUid == request.auth.uid &&
          getAfter(/databases/$(database)/documents/users/$(request.resource.data.nutritionistId)/patients/$(request.resource.data.patientId)).data.portalUid == request.auth.uid
        )
      );

      allow delete: if isAuthenticated() &&
        resource.data.nutritionistId == request.auth.uid &&
        isNutritionist(request.auth.uid);
    }

    // ------------------------------------------------------ users workspace
    match /users/{userId} {
      // Nutritionist owns their own workspace document.
      // Creation requires role == 'nutritionist'; role cannot be altered (no self-elevation).
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.data.role == "nutritionist";
      allow update: if isAuthenticated() &&
        request.auth.uid == userId &&
        resource.data.role == "nutritionist" &&
        request.resource.data.role == "nutritionist";
      allow delete: if false;

      match /patients/{patientId} {
        // Nutritionist has access to their patients.
        allow read, delete: if isNutritionist(userId);

        // Required fields and limits on creation
        allow create: if isNutritionist(userId) &&
          request.resource.data.firstName is string &&
          request.resource.data.firstName.size() > 0 &&
          request.resource.data.firstName.size() <= 100;

        // Update by nutritionist ensures portalUid immutability once linked,
        // but allows unlinking/revoking by setting portalUid to null or omitting it
        allow update: if isNutritionist(userId) &&
          (!('portalUid' in resource.data) ||
           resource.data.portalUid == null ||
           request.resource.data.portalUid == resource.data.portalUid ||
           request.resource.data.portalUid == null ||
           !('portalUid' in request.resource.data));

        // The associated patient may read their own record:
        // Must have matching patientProfile, must be linked in portalUid on this doc,
        // not revoked, not archived, not pending deletion.
        allow read: if isAssociatedPatient(userId, patientId) &&
          resource.data.portalUid == request.auth.uid &&
          (!('portalStatus' in resource.data) || resource.data.portalStatus != 'revoked') &&
          (!('status' in resource.data) || resource.data.status != 'Archived') &&
          (!('deletionPending' in resource.data) || resource.data.deletionPending != true);

        // ...and update ONLY self-service fields with validated non-decreasing history.
        // Archived records cannot be updated by the patient, even via the SDK.
        allow update: if isAssociatedPatient(userId, patientId) &&
          resource.data.portalUid == request.auth.uid &&
          (!('portalStatus' in resource.data) || resource.data.portalStatus != 'revoked') &&
          (!('status' in resource.data) || resource.data.status != 'Archived') &&
          (!('deletionPending' in resource.data) || resource.data.deletionPending != true) &&
          patientWriteIsSelfServiceValid();

        // Patient claiming portal access upon accepting invitation:
        // Can only set portalUid == request.auth.uid in an atomic batch that accepts a valid pending invitation
        allow update: if isAuthenticated() &&
          (!('portalUid' in resource.data) || resource.data.portalUid == null || resource.data.portalUid == request.auth.uid) &&
          (!('deletionPending' in resource.data) || resource.data.deletionPending != true) &&
          (!('status' in resource.data) || resource.data.status != 'Archived') &&
          'pendingInvitationId' in resource.data &&
          resource.data.pendingInvitationId == getAfter(/databases/$(database)/documents/patientProfiles/$(request.auth.uid)).data.invitationId &&
          request.resource.data.portalUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['portalUid', 'portalStatus']) &&
          // Atomic batch verification with patientProfile and invitation:
          existsAfter(/databases/$(database)/documents/patientProfiles/$(request.auth.uid)) &&
          getAfter(/databases/$(database)/documents/patientProfiles/$(request.auth.uid)).data.patientId == patientId &&
          getAfter(/databases/$(database)/documents/patientProfiles/$(request.auth.uid)).data.nutritionistId == userId &&
          'invitationId' in getAfter(/databases/$(database)/documents/patientProfiles/$(request.auth.uid)).data &&
          exists(/databases/$(database)/documents/invitations/$(getAfter(/databases/$(database)/documents/patientProfiles/$(request.auth.uid)).data.invitationId)) &&
          get(/databases/$(database)/documents/invitations/$(getAfter(/databases/$(database)/documents/patientProfiles/$(request.auth.uid)).data.invitationId)).data.status == "pending" &&
          get(/databases/$(database)/documents/invitations/$(getAfter(/databases/$(database)/documents/patientProfiles/$(request.auth.uid)).data.invitationId)).data.patientId == patientId &&
          get(/databases/$(database)/documents/invitations/$(getAfter(/databases/$(database)/documents/patientProfiles/$(request.auth.uid)).data.invitationId)).data.nutritionistId == userId &&
          'email' in request.auth.token &&
          request.auth.token.email.lower() == get(/databases/$(database)/documents/invitations/$(getAfter(/databases/$(database)/documents/patientProfiles/$(request.auth.uid)).data.invitationId)).data.patientEmail.lower() &&
          request.time < get(/databases/$(database)/documents/invitations/$(getAfter(/databases/$(database)/documents/patientProfiles/$(request.auth.uid)).data.invitationId)).data.expiresAtTimestamp &&
          getAfter(/databases/$(database)/documents/invitations/$(getAfter(/databases/$(database)/documents/patientProfiles/$(request.auth.uid)).data.invitationId)).data.status == "accepted" &&
          getAfter(/databases/$(database)/documents/invitations/$(getAfter(/databases/$(database)/documents/patientProfiles/$(request.auth.uid)).data.invitationId)).data.acceptedByUid == request.auth.uid;
      }

      match /diets/{dietId} {
        allow read, delete: if isNutritionist(userId);
        allow create, update: if isNutritionist(userId) &&
          'patientId' in request.resource.data &&
          isPatientActiveAndWritable(userId, request.resource.data.patientId);
        // The associated patient may read only their own diets.
        allow read: if isOwnerPatientByField(userId);
      }

      match /appointments/{apptId} {
        allow read, delete: if isNutritionist(userId);
        allow create, update: if isNutritionist(userId) &&
          'patientId' in request.resource.data &&
          isPatientActiveAndWritable(userId, request.resource.data.patientId);
        // The associated patient may read only their own appointments.
        allow read: if isOwnerPatientByField(userId);
      }
    }

    // ------------------------------------------------------ default deny
    // Anything not matched above is denied. Explicit for clarity/auditing.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
